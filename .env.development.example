# ================================================================
# 로컬 개발 환경 설정 파일 템플릿
# ================================================================
# 1. 이 파일을 복사해서 .env.development 로 저장하세요
#    cp .env.development.example .env.development
#
# 2. scripts/create_test_sheets.py 를 실행하면
#    아래 ID 값들이 자동으로 출력됩니다. 그 값을 붙여넣으세요.
#
# 3. .env.development 는 절대 git에 커밋하지 마세요!
#    (.gitignore에 이미 추가되어 있습니다)
# ================================================================

# 자산 관리 시트 (테스트용 복사본)
TEST_SPREADSHEET_ID=

# 소모품 마스터 시트 (테스트용 복사본)
TEST_CONSUMABLES_MASTER_ID=

# 소모품 출고 내역 시트 (테스트용 복사본)
TEST_CONSUMABLES_OUTBOUND_ID=

# 토너 재고 시트 (테스트용 복사본)
TEST_TONER_ID=
