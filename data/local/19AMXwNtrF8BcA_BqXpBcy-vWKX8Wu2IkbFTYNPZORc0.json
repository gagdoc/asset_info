    [
      "",
      "【알림 설정 (Google Sheets Apps Script)】"
    ],
    [
      "",
      "  → 확장 프로그램 > Apps Script 에서 아래 코드 붙여넣기:"
    ],
    [
      "",
      ""
    ],
    [
      "",
      "  function checkStock() {\n    var sheet = SpreadsheetApp.getActive().getSheetByName('토너_재고');\n    var data = sheet.getDataRange().getValues();\n    var alerts = [];\n    for (var i = 2; i < data.length; i++) {\n      var safe = data[i][6];   // G열: 안전재고\n      var actual = data[i][7]; // H열: 실재고\n      var toner = data[i][4];  // E열: 토너_품번\n      var printer = data[i][1];// B열: 복합기명\n      if (actual != \"\" && safe != \"\" && actual <= safe) {\n        alerts.push(printer + \" / \" + toner + \" (실재고: \" + actual + \")\");\n      }\n    }\n    if (alerts.length > 0) {\n      MailApp.sendEmail({\n        to: \"담당자이메일@company.com\",\n        subject: \"[알림] 토너 안전재고 도달\",\n        body: \"아래 토너가 안전재고 이하입니다:\\n\\n\" + alerts.join(\"\\n\")\n      });\n    }\n  }"
    ],
